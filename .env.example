# --- SEC EDGAR identity (REQUIRED by SEC fair-access policy) -------------------
# SEC asks every automated client to identify itself. Put a real name + email
# here in your local .env. Never commit a filled-in .env.
SEC_USER_AGENT="Your Name your.email@example.com"

# --- LLM (OPTIONAL) ------------------------------------------------------------
# Without a key the app runs in deterministic-only mode: financial comparison,
# risk-factor diffing, topic evidence retrieval and the Markdown brief all still
# work. Only the AI interpretation layer is disabled.
API_KEY=""
FCA_LLM_MODEL="claude-opus-5"
FCA_LLM_EFFORT="medium"
FCA_LLM_TIMEOUT="120"

# --- Behaviour -----------------------------------------------------------------
FCA_DEFAULT_TICKER="MSFT"
FCA_CACHE_DIR=".cache"
FCA_HTTP_TIMEOUT="30"
FCA_HTTP_MAX_RETRIES="3"
FCA_OFFLINE="0"
